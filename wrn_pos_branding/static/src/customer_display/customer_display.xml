<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="wrn_pos_branding.CustomerDisplay" t-inherit="point_of_sale.CustomerDisplay" t-inherit-mode="extension">
        <xpath expr="//div[contains(text(), 'Powered by')]" position="replace">
             <div class="position-absolute bottom-0 mb-4 d-none d-lg-flex align-items-center ps-3 pe-2 py-1 rounded-3 text-bg-dark small">POS Solution By WaranCloud</div>
        </xpath>
        <xpath expr="//div[contains(@class, 'bottom-0') and contains(text(), 'Powered by')]" position="replace">
            <div class=" bottom-0 mb-4 d-flex align-items-center ps-3 pe-2 py-1 rounded-3 small">POS Solution By WaranCloud</div>
        </xpath>
    </t>
</templates>
