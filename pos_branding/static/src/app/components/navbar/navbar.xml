<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <t t-name="pos_branding.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-logo')]" position="replace">
            <img t-att-src="'/web/image?model=res.company&amp;id=' + pos.company.id + '&amp;field=logo'"
                alt="Company Logo" class="pos-navbar-logo"/>
        </xpath>
    </t>
</odoo>
