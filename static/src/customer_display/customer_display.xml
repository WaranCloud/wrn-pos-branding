<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <t t-name="pos_branding.CustomerDisplay" t-inherit="point_of_sale.CustomerDisplay" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('text-bg-dark')]" position="replace">
            <div class="position-absolute bottom-0 mb-4 d-none d-lg-flex align-items-center ps-3 pe-2 py-1 rounded-3 text-bg-dark small">
                Solution By WaranCloud
            </div>
        </xpath>
        <xpath expr="//div[hasclass('bottom-0')][not(hasclass('text-bg-dark'))]" position="replace">
            <div class="bottom-0 mb-4 d-flex align-items-center ps-3 pe-2 py-1 rounded-3 small">
                Solution By WaranCloud
            </div>
        </xpath>
    </t>
</odoo>
